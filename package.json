{
  "name": "@kramtoske/fili",
  "version": "2.0.7",
  "main": "dist/fili.min.js",
  "author": "Florian Markert",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@cyclonedx/cyclonedx-npm": "^4.1.2",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "babelify": "^10.0.0",
    "bannerify": "^1.0.1",
    "browserify": "^17.0.1",
    "envify": "^4.1.0",
    "istanbul": "^0.4.5",
    "mocha": "^11.3.0",
    "should": "^13.2.3",
    "standard": "^17.1.2",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "build": "mkdir -p dist && browserify ./index.js --standalone Fili -t [babelify] -t [envify --NODE_ENV production] -p [bannerify --file ./banner.txt] -o ./dist/fili.js && uglifyjs ./dist/fili.js --compress --mangle --comments -o ./dist/fili.min.js",
    "build:all": "npm run build && npm run sbom",
    "prepack": "npm run build",
    "test": "standard && mocha --recursive test",
    "sbom": "mkdir -p dist && cyclonedx-npm --package-lock-only --ignore-npm-errors --validate --output-reproducible --output-file dist/sbom.cdx.json"
  },
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "presets": [
            "@babel/preset-env"
          ]
        }
      ]
    ]
  },
  "standard": {
    "ignore": [
      "dist/**",
      "demo/**",
      "test/**"
    ]
  }
}
